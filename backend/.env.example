# RestroIQ Backend Environment Configuration Template
# Copy this file to .env and populate with your credentials
# NEVER commit the actual .env file or credentials to Git.

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_KEY=your-supabase-publishable-key

# Note: SUPABASE_JWT_SECRET is NOT required when using Supabase's default asymmetric JWKS
# (RS256/ES256), as public verification keys are automatically retrieved from JWKS.
# SUPABASE_JWT_SECRET=your-jwt-secret-if-using-legacy-hs256

# Note: SUPABASE_SERVICE_ROLE_KEY is strictly reserved for administrative migration scripts.
# Tenant-scoped application routes NEVER use this key and rely exclusively on user JWTs + RLS.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-frontend

# Frontend Allowed Origins (Comma-separated)
FRONTEND_URL=https://restroiq.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Application Settings
PROJECT_NAME="RestroIQ API"
API_V1_STR=/api/v1
