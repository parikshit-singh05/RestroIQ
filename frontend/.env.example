# RestroIQ Frontend Environment Configuration Template
# Copy this file to .env and populate with your credentials

# Backend Base API URL (defaults to http://127.0.0.1:8000/api/v1 for local development)
VITE_API_BASE_URL=https://restroiq.onrender.com/api/v1

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
