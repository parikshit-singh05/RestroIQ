# RestroIQ Frontend Environment Configuration Template
# Copy this file to .env and populate with your credentials
# NEVER commit the actual .env file or credentials to Git.

# Backend Base API URL (defaults to http://127.0.0.1:8000/api/v1 for local development)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Client Configuration
# Only the public project URL and publishable/anon key belong in frontend code.
# NEVER place service role keys or database secret keys in frontend environment variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
